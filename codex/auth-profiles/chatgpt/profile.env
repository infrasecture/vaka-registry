# Auth profile: ChatGPT subscription via LiteLLM's native chatgpt/ provider.
#
# LiteLLM performs the OAuth device flow itself and mints/refreshes auth.json in
# the rw-mounted token dir; `myCodex login chatgpt` surfaces that flow (or imports
# an existing auth.json via MYCODEX_CHATGPT_AUTH). The agent never sees the token —
# it reaches the model only through the sidecar with the internal proxy key.
#
# Sourced by ./myCodex as trusted recipe content. Keep it to simple KEY=value.
PROFILE_DISPLAY_NAME="ChatGPT subscription"
CREDENTIAL_KIND=oauth-device-native
# GPT-6 Sol is the recipe default and the concrete route used for device login.
# MYCODEX_MODEL can override it for an invocation.
PROFILE_DEFAULT_MODEL=gpt-6-sol
PROFILE_LOGIN_MODEL=gpt-6-sol
# Remove only the default this recipe used to force into persistent config.
PROFILE_LEGACY_DEFAULT_MODEL=gpt-5.3-codex
