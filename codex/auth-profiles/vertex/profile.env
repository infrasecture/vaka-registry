# Auth profile (SCAFFOLD): Google Vertex AI via a mounted service-account / ADC
# credential file. Demonstrates the `credential-file` credential kind end to end.
#
# Usage:
#   MYCODEX_AUTH=vertex \
#   MYCODEX_VERTEX_CREDENTIALS=/path/to/service-account.json \
#   VERTEXAI_PROJECT=my-gcp-project VERTEXAI_LOCATION=us-central1 \
#   ./myCodex
#
# The wrapper resolves MYCODEX_VERTEX_CREDENTIALS to an absolute path and exports
# MYCODEX_CREDENTIAL_FILE, which overlay.yaml binds read-only into the sidecar.
#
# EXPERIMENTAL: model names, egress hosts, and the location-specific aiplatform
# endpoint must be verified against a real Vertex project before relying on it.
PROFILE_DISPLAY_NAME="Google Vertex AI (experimental)"
CREDENTIAL_KIND=credential-file
PROFILE_CREDENTIAL_ENV=MYCODEX_VERTEX_CREDENTIALS
PROFILE_DEFAULT_MODEL=gemini-2.5-pro
