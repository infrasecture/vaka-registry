#!/usr/bin/env bash
# Thin recipe wrapper around the vendored upstream launcher (bin/myCodex).
#
# It adds only what upstream does not provide: it collects the provider API key,
# maintains an internal LiteLLM proxy key, and routes every Compose call through
# vaka for egress enforcement (MYCODEX_COMPOSE). Everything else — host identity,
# path-parity workdir, per-project state (--private-env), attach/exec, readiness
# — is handled by the vendored launcher unchanged.

recipe_bash_is_supported() {
  (( BASH_VERSINFO[0] > 4 ||
    (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) ))
}

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Fail or re-exec before secret prompting. The vendored launcher owns the full
# diagnostic; this wrapper only handles a valid $SHELL early enough to preserve
# its own setup path.
if ! recipe_bash_is_supported; then
  candidate="${SHELL:-}"
  candidate_version=""
  case "${candidate}" in
    bash|*/bash)
      if [[ -x "${candidate}" ]]; then
        # shellcheck disable=SC2016 # Expanded by the candidate Bash.
        candidate_version="$(
          "${candidate}" --noprofile --norc -c '
            printf "%s" "${BASH_VERSION:-}"
            (( BASH_VERSINFO[0] > 4 ||
              (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) ))
          ' 2>/dev/null
        )" || candidate_version=""
      fi
      ;;
  esac

  if [[ -n "${candidate_version}" ]]; then
    printf 'myCodex: Bash %s (%s) is too old; restarting with Bash %s from SHELL=%s\n' \
      "${BASH_VERSION}" "${BASH:-bash}" "${candidate_version}" "${candidate}" >&2
    exec "${candidate}" "${BASH_SOURCE[0]}" "$@"
  fi

  exec "${BASH}" "${SCRIPT_DIR}/bin/myCodex" "$@"
fi

unset -f recipe_bash_is_supported
set -euo pipefail

CALLER_DIR="$(pwd -P)"

# Running from the recipe directory would bind-mount this directory — including
# .secrets — into the container as the workspace. Refuse it.
if [[ "${CALLER_DIR}" == "${SCRIPT_DIR}" ]]; then
  echo "myCodex: running from its own directory exposes secrets inside the container; run it from a project dir." >&2
  exit 2
fi

# Pinned harness image, kept in sync with docker-compose.yaml. Setting these
# makes the launcher's pre-up image-tag resolution use this value verbatim
# instead of probing the registry; the compose file pins by digest, so the tag
# is only informational.
export MYCODEX_IMAGE_NAME="ghcr.io/infrasecture/harness-workstation"
export MYCODEX_IMAGE_TAG="0.146.0"

read_secret_value() {
  local env_name="$1"
  local secret_file="$2"
  local env_value

  if [[ ! -f "${secret_file}" ]]; then
    echo "myCodex: ${secret_file} must resolve to a readable regular file for ${env_name}." >&2
    return 2
  fi
  if ! IFS= read -r env_value < "${secret_file}"; then
    # A final line without a newline is a valid one-line secret.
    [[ -n "${env_value}" ]] || {
      echo "myCodex: failed to read ${env_name} from ${secret_file}." >&2
      return 2
    }
  fi
  if [[ -z "${env_value}" ]]; then
    echo "myCodex: ${secret_file} is empty; ${env_name} is required." >&2
    return 2
  fi

  printf '%s' "${env_value}"
}

ensure_managed_secrets_dir() {
  local env_name="$1"
  local secrets_dir="$2"

  if [[ -L "${secrets_dir}" ]]; then
    echo "myCodex: ${secrets_dir} is a symlink; managed secret storage must be a real directory." >&2
    echo "myCodex: set ${env_name} or ${env_name}_FILE to use an external secret source." >&2
    return 2
  fi
  if [[ -e "${secrets_dir}" ]]; then
    if [[ ! -d "${secrets_dir}" ]]; then
      echo "myCodex: ${secrets_dir} exists but is not a directory." >&2
      return 2
    fi
    return
  fi

  if ! (umask 077 && mkdir -p -- "${secrets_dir}"); then
    echo "myCodex: failed to create managed secret directory ${secrets_dir}." >&2
    return 2
  fi
  if [[ -L "${secrets_dir}" || ! -d "${secrets_dir}" ]]; then
    echo "myCodex: ${secrets_dir} did not resolve to a managed directory after creation." >&2
    return 2
  fi
}

read_managed_secret_value() {
  local env_name="$1"
  local secret_file="$2"

  if [[ -L "${secret_file}" ]]; then
    echo "myCodex: ${secret_file} is a symlink; managed secret files must be regular files." >&2
    echo "myCodex: set ${env_name}_FILE to use an external file, including a symlink." >&2
    return 2
  fi
  if [[ -e "${secret_file}" && ! -f "${secret_file}" ]]; then
    echo "myCodex: ${secret_file} exists but is not a regular file." >&2
    return 2
  fi

  read_secret_value "${env_name}" "${secret_file}"
}

persist_managed_secret_value() {
  local env_name="$1"
  local secret_file="$2"
  local env_value="$3"
  local secrets_dir temp_file winner
  secrets_dir="$(dirname -- "${secret_file}")"

  temp_file="$(mktemp "${secrets_dir}/.$(basename -- "${secret_file}").XXXXXX")" || {
    echo "myCodex: failed to create a temporary file for ${secret_file}." >&2
    return 2
  }
  chmod 600 "${temp_file}"
  if ! printf '%s\n' "${env_value}" > "${temp_file}"; then
    rm -f -- "${temp_file}"
    echo "myCodex: failed to write ${secret_file}." >&2
    return 2
  fi

  # Publish only a complete file, without replacing a concurrent winner or an
  # existing path. Hard links provide this no-clobber operation on both Linux
  # and macOS without requiring flock.
  if command ln "${temp_file}" "${secret_file}" 2>/dev/null; then
    rm -f -- "${temp_file}"
    printf '%s' "${env_value}"
    return
  fi
  rm -f -- "${temp_file}"

  if winner="$(read_managed_secret_value "${env_name}" "${secret_file}")"; then
    printf '%s' "${winner}"
    return
  fi
  echo "myCodex: failed to atomically persist ${env_name} in ${secret_file}." >&2
  return 2
}

prompt_secret_value() {
  local env_name="$1"
  local env_value

  if ! { : < /dev/tty > /dev/tty; } 2>/dev/null; then
    echo "myCodex: ${env_name} is not set and no stored value exists; cannot prompt without a tty." >&2
    return 2
  fi
  printf 'Enter %s: ' "${env_name}" > /dev/tty
  if ! IFS= read -r -s env_value < /dev/tty; then
    printf '\n' > /dev/tty
    echo "myCodex: failed to read ${env_name}." >&2
    return 2
  fi
  printf '\n' > /dev/tty
  if [[ -z "${env_value}" ]]; then
    echo "myCodex: ${env_name} cannot be empty." >&2
    return 2
  fi

  printf '%s' "${env_value}"
}

generate_litellm_proxy_key() {
  local proxy_key

  if command -v openssl >/dev/null 2>&1; then
    proxy_key="$(openssl rand -hex 32)"
  else
    proxy_key="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  fi

  if [[ -z "${proxy_key}" ]]; then
    echo "myCodex: failed to generate LiteLLM proxy key" >&2
    exit 2
  fi

  printf '%s' "${proxy_key}"
}

resolve_secret_env() {
  local env_name="$1"
  local managed_name="$2"
  local acquisition="$3"
  local env_value="${!env_name-}"
  local file_env_name="${env_name}_FILE"
  local explicit_file="${!file_env_name-}"
  local secrets_dir="${SCRIPT_DIR}/.secrets"
  local secret_file="${secrets_dir}/${managed_name}"

  if [[ -n "${env_value}" && -n "${explicit_file}" ]]; then
    echo "myCodex: set only one of ${env_name} and ${file_env_name}." >&2
    return 2
  fi
  if [[ -n "${env_value}" ]]; then
    export "${env_name}=${env_value}"
    return
  fi
  if [[ -n "${explicit_file}" ]]; then
    env_value="$(read_secret_value "${env_name}" "${explicit_file}")"
    export "${env_name}=${env_value}"
    return
  fi

  if [[ -e "${secrets_dir}" || -L "${secrets_dir}" ]]; then
    ensure_managed_secrets_dir "${env_name}" "${secrets_dir}"
    if [[ -e "${secret_file}" || -L "${secret_file}" ]]; then
      env_value="$(read_managed_secret_value "${env_name}" "${secret_file}")"
      export "${env_name}=${env_value}"
      return
    fi
  fi

  case "${acquisition}" in
    prompt)
      env_value="$(prompt_secret_value "${env_name}")"
      ;;
    generate)
      env_value="$(generate_litellm_proxy_key)"
      ;;
    *)
      echo "myCodex: internal error: unknown secret acquisition policy ${acquisition}." >&2
      return 2
      ;;
  esac
  ensure_managed_secrets_dir "${env_name}" "${secrets_dir}"
  env_value="$(persist_managed_secret_value "${env_name}" "${secret_file}" "${env_value}")"
  export "${env_name}=${env_value}"
}

die() {
  echo "myCodex: $*" >&2
  exit 2
}

# ---------------------------------------------------------------------------
# Auth profiles
#
# MYCODEX_AUTH selects how the LiteLLM sidecar authenticates upstream. The agent
# container is auth-agnostic — it always speaks to the sidecar with the internal
# proxy key — so only the sidecar's provider config, credential, and egress
# change between profiles.
#
# The default profile "openai" is realized by the recipe's root files
# (docker-compose.yaml, vaka.yaml, litellm.config.yaml) and needs no overlay, so
# it stays exactly the artifact validated by registry CI. Every other profile is
# data under auth-profiles/<id>/: profile.env (manifest), overlay.yaml (compose
# overlay), litellm.config.yaml, and vaka.yaml (a complete egress policy).
# ---------------------------------------------------------------------------

# The selected profile is non-secret recipe state. Keeping it beside the managed
# credentials gives it the same update-preserved lifecycle without introducing a
# second state directory.
AUTH_PROFILE_FILE="${SCRIPT_DIR}/.secrets/auth_profile"
AUTH_SELECTION_SOURCE=""

# The launcher derives the codex container name deterministically from the
# caller directory; replicate it so we can inspect a running stack's profile.
# Keep this in sync with bin/myCodex's PROJECT_NAME/CONTAINER_NAME derivation.
CODEX_PROJECT_NAME="$(basename -- "${CALLER_DIR}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//')"
[[ -n "${CODEX_PROJECT_NAME}" ]] || CODEX_PROJECT_NAME="workspace"
CODEX_CONTAINER_NAME="${CODEX_PROJECT_NAME}-codex"

# Profile fields; defaults describe the built-in "openai" profile.
PROFILE_VAKA_FILE="${SCRIPT_DIR}/vaka.yaml"
PROFILE_OVERLAY=""
PROFILE_LITELLM_CONFIG=""
CREDENTIAL_KIND="env-secret"
PROFILE_SECRET_ENV="OPENAI_API_KEY"
PROFILE_SECRET_MANAGED="openai_api_key"
PROFILE_CREDENTIAL_ENV=""
PROFILE_DEFAULT_MODEL=""
PROFILE_DISPLAY_NAME="OpenAI API key"

validate_profile_id() {
  case "$1" in
    ''|.|..|*[!a-z0-9._-]*)
      die "invalid MYCODEX_AUTH profile id: '$1'"
      ;;
  esac
}

read_persisted_auth_profile() {
  local value _extra

  [[ -e "${AUTH_PROFILE_FILE}" || -L "${AUTH_PROFILE_FILE}" ]] || return 1
  [[ ! -L "${AUTH_PROFILE_FILE}" && -f "${AUTH_PROFILE_FILE}" ]] \
    || die "${AUTH_PROFILE_FILE} must be a managed regular file, not a symlink or other file"

  {
    IFS= read -r value || [[ -n "${value}" ]] \
      || die "${AUTH_PROFILE_FILE} is empty"
    if IFS= read -r _extra; then
      die "${AUTH_PROFILE_FILE} must contain exactly one profile id"
    fi
  } < "${AUTH_PROFILE_FILE}"

  validate_profile_id "${value}"
  printf '%s' "${value}"
}

persist_auth_profile() {
  local profile="$1"
  local temp_file

  validate_profile_id "${profile}"
  ensure_managed_secrets_dir "MYCODEX_AUTH" "${SCRIPT_DIR}/.secrets" || exit $?
  if [[ -L "${AUTH_PROFILE_FILE}" || ( -e "${AUTH_PROFILE_FILE}" && ! -f "${AUTH_PROFILE_FILE}" ) ]]; then
    die "${AUTH_PROFILE_FILE} must be a managed regular file, not a symlink or other file"
  fi

  temp_file="$(mktemp "${SCRIPT_DIR}/.secrets/.auth_profile.XXXXXX")" \
    || die "failed to create a temporary auth-profile file"
  chmod 600 "${temp_file}"
  if ! printf '%s\n' "${profile}" > "${temp_file}"; then
    rm -f -- "${temp_file}"
    die "failed to write the selected auth profile"
  fi
  if ! command mv -f "${temp_file}" "${AUTH_PROFILE_FILE}"; then
    rm -f -- "${temp_file}"
    die "failed to persist the selected auth profile"
  fi
}

clear_persisted_auth_profile() {
  local selected

  [[ -e "${AUTH_PROFILE_FILE}" || -L "${AUTH_PROFILE_FILE}" ]] || return 0
  selected="$(read_persisted_auth_profile)"
  [[ "${selected}" == "$1" ]] || return 0
  rm -f -- "${AUTH_PROFILE_FILE}" || die "failed to clear ${AUTH_PROFILE_FILE}"
}

available_auth_profiles() {
  local dir
  printf '%s\n' openai
  shopt -s nullglob
  for dir in "${SCRIPT_DIR}"/auth-profiles/*; do
    [[ -f "${dir}/profile.env" ]] || continue
    basename -- "${dir}"
  done
  shopt -u nullglob
}

auth_profile_display_name() (
  local profile="$1"
  local manifest

  if [[ "${profile}" == "openai" ]]; then
    printf '%s' "OpenAI API key"
    return
  fi

  manifest="${SCRIPT_DIR}/auth-profiles/${profile}/profile.env"
  PROFILE_DISPLAY_NAME="${profile}"
  # profile.env is trusted recipe content, just as it is during normal profile
  # resolution. Run it in a subshell so listing cannot alter active state.
  # shellcheck disable=SC1090
  source "${manifest}"
  printf '%s' "${PROFILE_DISPLAY_NAME:-${profile}}"
)

print_auth_profiles() {
  local profile
  while IFS= read -r profile; do
    printf '  %-12s %s\n' "${profile}" "$(auth_profile_display_name "${profile}")"
  done < <(available_auth_profiles)
}

select_auth_profile_interactively() {
  local profiles=()
  local choice profile index

  if ! { : < /dev/tty > /dev/tty; } 2>/dev/null; then
    echo "myCodex: no authentication profile is selected; specify one explicitly:" >&2
    echo "  myCodex login <profile>" >&2
    echo "myCodex: available profiles:" >&2
    print_auth_profiles >&2
    return 2
  fi

  mapfile -t profiles < <(available_auth_profiles)
  printf 'Select an authentication profile:\n' > /dev/tty
  for index in "${!profiles[@]}"; do
    profile="${profiles[index]}"
    printf '  %d) %-12s %s\n' "$((index + 1))" "${profile}" \
      "$(auth_profile_display_name "${profile}")" > /dev/tty
  done
  printf 'Profile: ' > /dev/tty
  IFS= read -r choice < /dev/tty || return 130

  if [[ "${choice}" =~ ^[1-9][0-9]*$ ]] && (( choice <= ${#profiles[@]} )); then
    printf '%s' "${profiles[choice - 1]}"
    return
  fi
  for profile in "${profiles[@]}"; do
    if [[ "${choice}" == "${profile}" ]]; then
      printf '%s' "${profile}"
      return
    fi
  done
  echo "myCodex: unknown authentication profile '${choice}'" >&2
  return 2
}

resolve_auth_profile() {
  [[ "${MYCODEX_AUTH}" == "openai" ]] && return

  validate_profile_id "${MYCODEX_AUTH}"
  local dir="${SCRIPT_DIR}/auth-profiles/${MYCODEX_AUTH}"
  local manifest="${dir}/profile.env"
  [[ -f "${manifest}" ]] || die "unknown auth profile '${MYCODEX_AUTH}' (expected ${manifest})"

  # profile.env is trusted recipe content (like bin/lib/mycodex-image.sh). Reset
  # the fields it may set, then source it.
  CREDENTIAL_KIND=""
  PROFILE_SECRET_ENV=""
  PROFILE_SECRET_MANAGED=""
  PROFILE_CREDENTIAL_ENV=""
  PROFILE_DEFAULT_MODEL=""
  PROFILE_DISPLAY_NAME="${MYCODEX_AUTH}"
  # shellcheck disable=SC1090
  source "${manifest}"

  PROFILE_VAKA_FILE="${dir}/vaka.yaml"
  PROFILE_OVERLAY="${dir}/overlay.yaml"
  [[ -f "${PROFILE_VAKA_FILE}" ]] || die "auth profile '${MYCODEX_AUTH}' is missing vaka.yaml"
  [[ -f "${PROFILE_OVERLAY}" ]] || die "auth profile '${MYCODEX_AUTH}' is missing overlay.yaml"
  [[ -n "${CREDENTIAL_KIND}" ]] || die "auth profile '${MYCODEX_AUTH}' does not set CREDENTIAL_KIND"
  if [[ -f "${dir}/litellm.config.yaml" ]]; then
    # Compose resolves relative bind sources against the project directory (the
    # base compose file's dir, i.e. the recipe root), so keep this repo-relative.
    PROFILE_LITELLM_CONFIG="./auth-profiles/${MYCODEX_AUTH}/litellm.config.yaml"
  fi
}

# The oauth-device-native token dir is bind-mounted rw into the sidecar; create
# it (0700) up front so Docker does not create it root-owned on first `up`.
ensure_chatgpt_token_dir() {
  ensure_managed_secrets_dir "MYCODEX_AUTH" "${SCRIPT_DIR}/.secrets" || exit $?
  local dir="${SCRIPT_DIR}/.secrets/chatgpt-token"
  [[ -d "${dir}" ]] && return
  (umask 077 && mkdir -p -- "${dir}") || die "failed to create ${dir}"
}

# credential-file kind: PROFILE_CREDENTIAL_ENV names a host env var whose value
# is a path to a credential file (e.g. a GCP service-account JSON). The wrapper
# never reads or copies the file; it exports MYCODEX_CREDENTIAL_FILE (an absolute
# path) for the profile overlay to bind read-only into the sidecar.
resolve_credential_file() {
  local var="${PROFILE_CREDENTIAL_ENV}"
  [[ -n "${var}" ]] || die "profile '${MYCODEX_AUTH}': credential-file kind requires PROFILE_CREDENTIAL_ENV"
  local path="${!var-}"
  [[ -n "${path}" ]] || die "set ${var} to the path of the ${MYCODEX_AUTH} credential file"
  [[ -f "${path}" ]] || die "${var}: ${path} must be a readable regular file"
  local abs
  abs="$(cd -- "$(dirname -- "${path}")" >/dev/null 2>&1 && printf '%s/%s' "$(pwd -P)" "$(basename -- "${path}")")" \
    || die "cannot resolve ${var}=${path}"
  export MYCODEX_CREDENTIAL_FILE="${abs}"
}

# Acquire everything the selected profile needs to (re)create the stack. The
# agent<->gateway proxy key is minted and persisted for every profile.
acquire_credentials() {
  case "${CREDENTIAL_KIND}" in
    env-secret)
      [[ -n "${PROFILE_SECRET_ENV}" && -n "${PROFILE_SECRET_MANAGED}" ]] \
        || die "profile '${MYCODEX_AUTH}': env-secret kind requires PROFILE_SECRET_ENV and PROFILE_SECRET_MANAGED"
      resolve_secret_env "${PROFILE_SECRET_ENV}" "${PROFILE_SECRET_MANAGED}" prompt
      ;;
    oauth-device-native)
      ensure_chatgpt_token_dir
      ;;
    credential-file)
      resolve_credential_file
      ;;
    *)
      die "profile '${MYCODEX_AUTH}': unknown CREDENTIAL_KIND '${CREDENTIAL_KIND}'"
      ;;
  esac
  resolve_secret_env LITELLM_MASTER_KEY litellm_master_key generate
}

# `docker compose start`/`restart` (and attaching to an already-running stack) do
# not recreate containers, so they cannot apply a different profile's config or
# egress policy. Refuse rather than run one profile's containers under another's
# name. A stack created before this label existed, or a missing docker CLI,
# degrades to no-op (nothing to compare against).
guard_profile_switch() {
  command -v docker >/dev/null 2>&1 || return 0
  local running
  running="$(docker inspect --format '{{ index .Config.Labels "agent.vaka.codex.auth-profile" }}' \
    "${CODEX_CONTAINER_NAME}" 2>/dev/null)" || return 0
  [[ -n "${running}" && "${running}" != "${MYCODEX_AUTH}" ]] || return 0
  die "this project is running under auth profile '${running}', not '${MYCODEX_AUTH}'.
myCodex: start/restart cannot switch profiles (they do not recreate containers).
myCodex: run '${SCRIPT_DIR}/myCodex down' then '${SCRIPT_DIR}/myCodex up' to switch to '${MYCODEX_AUTH}'."
}

# Import a pre-existing ChatGPT auth.json into the sidecar token dir, normalizing
# Codex's nested `tokens` layout to the top-level fields LiteLLM's chatgpt/
# provider expects (mirrors isec's NormalizeChatGPTAuth).
import_chatgpt_auth() {
  local src="$1" dst="$2"
  [[ -f "${src}" ]] || die "MYCODEX_CHATGPT_AUTH: ${src} is not a readable file"
  command -v python3 >/dev/null 2>&1 \
    || die "python3 is required to import MYCODEX_CHATGPT_AUTH; otherwise use the interactive login"
  ensure_chatgpt_token_dir
  python3 - "${src}" "${dst}" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
raw = json.load(open(src))
if isinstance(raw.get("access_token"), str):
    out = raw
else:
    tokens = raw.get("tokens") or {}
    out = {k: tokens[k] for k in ("access_token", "refresh_token", "id_token", "account_id")
           if isinstance(tokens.get(k), str) and tokens[k]}
    for k in ("auth_mode", "last_refresh"):
        if k in raw:
            out[k] = raw[k]
if not isinstance(out.get("access_token"), str) or not out["access_token"]:
    sys.exit("MYCODEX_CHATGPT_AUTH: no access_token found to import")
fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(out, f, indent=2)
PY
}

launcher() {
  "${BASH}" "${SCRIPT_DIR}/bin/myCodex" "${private_env[@]}" "${profile_files[@]}" "$@"
}

follow_litellm_logs() {
  exec "${BASH}" "${SCRIPT_DIR}/bin/myCodex" \
    "${private_env[@]}" "${profile_files[@]}" logs --tail=0 -f litellm
}

# `myCodex login` primes the selected profile's credential. For env-secret /
# credential-file this just resolves and stores the input; for oauth-device-native
# it surfaces LiteLLM's own device flow (which mints and later refreshes the
# token) or imports an existing auth.json via MYCODEX_CHATGPT_AUTH.
run_login() {
  case "${CREDENTIAL_KIND}" in
    env-secret)
      acquire_credentials
      echo "myCodex: profile '${MYCODEX_AUTH}' stores an API key; nothing else to do." >&2
      ;;
    credential-file)
      acquire_credentials
      echo "myCodex: profile '${MYCODEX_AUTH}' uses credential file ${MYCODEX_CREDENTIAL_FILE}." >&2
      ;;
    oauth-device-native)
      run_oauth_device_login
      ;;
    *)
      die "login is not supported for CREDENTIAL_KIND '${CREDENTIAL_KIND}'"
      ;;
  esac
}

selected_credential_status() {
  local env_name file_env_name managed_file token_file

  case "${CREDENTIAL_KIND}" in
    env-secret)
      env_name="${PROFILE_SECRET_ENV}"
      file_env_name="${env_name}_FILE"
      managed_file="${SCRIPT_DIR}/.secrets/${PROFILE_SECRET_MANAGED}"
      if [[ -n "${!env_name-}" ]]; then
        printf 'provided by %s' "${env_name}"
      elif [[ -n "${!file_env_name-}" ]]; then
        printf 'provided by %s' "${file_env_name}"
      elif [[ -s "${managed_file}" && ! -L "${managed_file}" ]]; then
        printf 'stored by myCodex'
      elif [[ -e "${managed_file}" || -L "${managed_file}" ]]; then
        printf 'invalid managed credential at %s' "${managed_file}"
      else
        printf 'not configured'
      fi
      ;;
    oauth-device-native)
      token_file="${SCRIPT_DIR}/.secrets/chatgpt-token/auth.json"
      if chatgpt_auth_complete "${token_file}"; then
        printf 'token stored by myCodex'
      elif [[ -e "${token_file}" || -L "${token_file}" ]]; then
        printf 'device login incomplete or invalid'
      else
        printf 'not logged in'
      fi
      ;;
    credential-file)
      env_name="${PROFILE_CREDENTIAL_ENV}"
      if [[ -n "${!env_name-}" ]]; then
        printf 'provided by %s' "${env_name}"
      else
        printf 'not configured'
      fi
      ;;
    *)
      printf 'unsupported credential kind %s' "${CREDENTIAL_KIND}"
      ;;
  esac
}

running_auth_profile() {
  command -v docker >/dev/null 2>&1 || return 1
  docker inspect --format '{{ index .Config.Labels "agent.vaka.codex.auth-profile" }}' \
    "${CODEX_CONTAINER_NAME}" 2>/dev/null
}

run_auth_status() {
  local fallback running

  printf 'Selected profile: %s (%s)\n' "${MYCODEX_AUTH}" "${AUTH_SELECTION_SOURCE}"
  printf 'Authentication:  %s\n' "$(selected_credential_status)"
  if [[ "${AUTH_SELECTION_SOURCE}" != "persisted" \
      && ( -e "${AUTH_PROFILE_FILE}" || -L "${AUTH_PROFILE_FILE}" ) ]]; then
    fallback="$(read_persisted_auth_profile)"
    printf 'Stored default:  %s\n' "${fallback}"
  fi
  if running="$(running_auth_profile)" && [[ -n "${running}" ]]; then
    printf 'Running profile: %s\n' "${running}"
  else
    printf 'Running profile: none for this project\n'
  fi
}

run_auth_list() {
  local profile marker

  while IFS= read -r profile; do
    marker=" "
    [[ "${profile}" == "${MYCODEX_AUTH}" ]] && marker="*"
    printf '%s %-12s %s\n' "${marker}" "${profile}" \
      "$(auth_profile_display_name "${profile}")"
  done < <(available_auth_profiles)
}

run_logout() {
  local file_env_name managed_file token_dir token_file running removed=0

  case "${CREDENTIAL_KIND}" in
    env-secret)
      managed_file="${SCRIPT_DIR}/.secrets/${PROFILE_SECRET_MANAGED}"
      if [[ -L "${managed_file}" ]]; then
        die "${managed_file} is a symlink; refusing to treat it as managed credential state"
      fi
      if [[ -e "${managed_file}" ]]; then
        [[ -f "${managed_file}" ]] || die "${managed_file} is not a regular file"
        rm -f -- "${managed_file}" || die "failed to remove ${managed_file}"
        removed=1
      fi
      file_env_name="${PROFILE_SECRET_ENV}_FILE"
      if [[ -n "${!PROFILE_SECRET_ENV-}" || -n "${!file_env_name-}" ]]; then
        echo "myCodex: ${PROFILE_SECRET_ENV} is still supplied externally and was not changed." >&2
      fi
      ;;
    oauth-device-native)
      token_dir="${SCRIPT_DIR}/.secrets/chatgpt-token"
      token_file="${token_dir}/auth.json"
      [[ ! -L "${token_dir}" ]] || die "${token_dir} is a symlink; refusing to modify it"
      [[ ! -L "${token_file}" ]] || die "${token_file} is a symlink; refusing to modify it"
      if [[ -e "${token_file}" ]]; then
        [[ -f "${token_file}" ]] || die "${token_file} is not a regular file"
        rm -f -- "${token_file}" || die "failed to remove ${token_file}"
        removed=1
      fi
      ;;
    credential-file)
      echo "myCodex: profile '${MYCODEX_AUTH}' uses an external credential file; it was not modified." >&2
      ;;
    *)
      die "logout is not supported for CREDENTIAL_KIND '${CREDENTIAL_KIND}'"
      ;;
  esac

  clear_persisted_auth_profile "${MYCODEX_AUTH}"
  if (( removed )); then
    echo "myCodex: removed the managed credential for profile '${MYCODEX_AUTH}'." >&2
  else
    echo "myCodex: no managed credential was stored for profile '${MYCODEX_AUTH}'." >&2
  fi
  if running="$(running_auth_profile)" && [[ "${running}" == "${MYCODEX_AUTH}" ]]; then
    echo "myCodex: running containers were not changed; bring this project down to end its current session." >&2
  fi
}

print_wrapper_auth_help() {
  cat <<'EOF'

Authentication commands added by the recipe wrapper:
  myCodex login [profile]           Authenticate and select a persistent profile
  myCodex logout [profile]          Remove myCodex-managed credentials
  myCodex auth status               Show selected, stored, and running profiles
  myCodex auth list                 List available profiles
  myCodex --auth <profile> ...      Override the profile for one invocation

MYCODEX_AUTH remains a one-invocation override for automation. A profile passed
to `login` is stored only after authentication succeeds.
EOF
}

# Login is complete only when auth.json actually carries a non-empty access_token.
# LiteLLM writes intermediate device-flow state (e.g. device_code_requested_at)
# to that file before the browser step finishes, so a merely non-empty file does
# not mean success.
chatgpt_auth_complete() {
  local file="$1"
  [[ -s "${file}" ]] || return 1
  grep -Eq '"access_token"[[:space:]]*:[[:space:]]*"[^"]+"' "${file}"
}

# Poll LiteLLM until it returns a successful liveliness response. `up -d`
# returns once containers have started, not once the proxy is serving. Bound the
# whole readiness phase by wall-clock time; an individual curl timeout must not
# silently multiply the advertised deadline.
wait_for_litellm_ready() {
  local timeout="$1"
  local deadline=$((SECONDS + timeout))
  local remaining request_timeout sleep_for

  while (( SECONDS < deadline )); do
    remaining=$((deadline - SECONDS))
    request_timeout=3
    (( remaining < request_timeout )) && request_timeout="${remaining}"

    if docker exec "${CODEX_CONTAINER_NAME}" \
        curl --fail --silent --show-error --output /dev/null \
          --max-time "${request_timeout}" \
          http://litellm:4000/health/liveliness >/dev/null 2>&1; then
      return 0
    fi

    remaining=$((deadline - SECONDS))
    (( remaining > 0 )) || break
    sleep_for=2
    (( remaining < sleep_for )) && sleep_for="${remaining}"
    sleep "${sleep_for}"
  done
  return 1
}

read_positive_timeout() {
  local name="$1"
  local fallback="$2"
  local value="${!name:-${fallback}}"
  [[ "${value}" =~ ^[1-9][0-9]*$ ]] \
    || die "${name} must be a positive whole number of seconds (got '${value}')"
  printf '%s' "${value}"
}

# Send exactly one request to trigger LiteLLM's provider-owned device flow. It
# remains pending while the user completes browser login and MFA. The caller
# watches both auth.json and this process: an early request failure is a real
# error, not a reason to silently create another device code.
CHATGPT_PROBE_PID=0
trigger_chatgpt_device_flow() {
  local model="$1"
  local timeout="$2"
  local payload

  case "${model}" in
    ''|*[!A-Za-z0-9._:/@+-]*)
      die "ChatGPT login model contains unsupported characters: '${model}'"
      ;;
  esac
  printf -v payload '{"model":"%s","input":"login probe"}' "${model}"

  # Expand OPENAI_API_KEY inside the container so the long-lived host-side
  # `docker exec` process does not expose the proxy key in its argv.
  docker exec "${CODEX_CONTAINER_NAME}" bash -lc \
    'exec curl --fail --silent --show-error --output /dev/null \
      --max-time "$1" \
      http://litellm:4000/v1/responses \
      --header "Authorization: Bearer ${OPENAI_API_KEY}" \
      --header "Content-Type: application/json" \
      --data "$2"' \
    _ "${timeout}" "${payload}" &
  CHATGPT_PROBE_PID=$!
}

stop_login_child() {
  local pid="$1"
  (( pid > 0 )) || return 0
  kill "${pid}" 2>/dev/null || true
  wait "${pid}" 2>/dev/null || true
}

run_chatgpt_device_flow() (
  local token_file="$1"
  local model="$2"
  local ready_timeout="$3"
  local login_timeout="$4"
  local log_pid=0
  local probe_pid=0

  trap 'stop_login_child "${log_pid}"; stop_login_child "${probe_pid}"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP

  echo "myCodex: waiting for the LiteLLM sidecar to accept requests (up to ${ready_timeout}s)..." >&2
  wait_for_litellm_ready "${ready_timeout}" \
    || die "LiteLLM did not become ready within ${ready_timeout}s; inspect '${SCRIPT_DIR}/myCodex logs litellm' and retry"

  # Follow only new output so a code from an earlier login attempt cannot be
  # mistaken for the current one.
  follow_litellm_logs &
  log_pid=$!

  local deadline=$((SECONDS + login_timeout))
  local next_status=$((SECONDS + 30))
  local remaining probe_status sleep_for
  local request_timeout=$((login_timeout + 5))

  echo "myCodex: waiting up to ${login_timeout}s for browser authorization and MFA; press Ctrl-C to cancel." >&2
  trigger_chatgpt_device_flow "${model}" "${request_timeout}"
  probe_pid="${CHATGPT_PROBE_PID}"

  while ! chatgpt_auth_complete "${token_file}"; do
    if (( SECONDS >= deadline )); then
      die "ChatGPT device code expired after ${login_timeout}s; rerun '${SCRIPT_DIR}/myCodex login' to request a new code"
    fi

    if ! kill -0 "${probe_pid}" 2>/dev/null; then
      if wait "${probe_pid}"; then
        probe_status=0
      else
        probe_status=$?
      fi
      probe_pid=0
      chatgpt_auth_complete "${token_file}" && break
      die "ChatGPT device-login request ended before credentials were issued (exit ${probe_status}); review the LiteLLM output above and retry"
    fi

    if (( SECONDS >= next_status )); then
      remaining=$((deadline - SECONDS))
      echo "myCodex: still waiting for browser authorization (${remaining}s remaining; Ctrl-C cancels)." >&2
      next_status=$((SECONDS + 30))
    fi
    remaining=$((deadline - SECONDS))
    (( remaining > 0 )) || continue
    sleep_for=2
    (( remaining < sleep_for )) && sleep_for="${remaining}"
    sleep "${sleep_for}"
  done

  echo "myCodex: ChatGPT login complete; token stored at ${token_file}." >&2
)

run_oauth_device_login() {
  acquire_credentials
  local token_file="${SCRIPT_DIR}/.secrets/chatgpt-token/auth.json"

  if [[ -n "${MYCODEX_CHATGPT_AUTH:-}" ]]; then
    import_chatgpt_auth "${MYCODEX_CHATGPT_AUTH}" "${token_file}"
    echo "myCodex: imported ChatGPT auth into ${token_file}." >&2
    return
  fi

  if chatgpt_auth_complete "${token_file}"; then
    echo "myCodex: a ChatGPT token already exists at ${token_file}; nothing to do." >&2
    return
  fi

  command -v docker >/dev/null 2>&1 || die "docker is required for 'myCodex login'"

  echo "myCodex: starting the LiteLLM ChatGPT device login." >&2
  echo "myCodex: a verification URL and code will appear below — open the URL," >&2
  echo "myCodex: sign in, and enter the code. This runs once; the token refreshes itself." >&2

  local model="${MYCODEX_MODEL:-${PROFILE_DEFAULT_MODEL:-gpt-5.3-codex}}"
  local ready_timeout login_timeout
  ready_timeout="$(read_positive_timeout MYCODEX_CHATGPT_READY_TIMEOUT 60)"
  login_timeout="$(read_positive_timeout MYCODEX_CHATGPT_LOGIN_TIMEOUT 900)"

  launcher up -d || die "failed to start the stack for login"

  run_chatgpt_device_flow "${token_file}" "${model}" "${ready_timeout}" "${login_timeout}"
}

# Parse the wrapper's one root option before handing the remaining argv to the
# vendored launcher. `login <profile>` is also an explicit CLI selection and has
# the same precedence as --auth.
wrapper_args=("$@")
auth_option=""
case "${wrapper_args[0]-}" in
  --auth)
    [[ ${#wrapper_args[@]} -ge 2 && -n "${wrapper_args[1]}" ]] \
      || die "--auth requires a profile id"
    auth_option="${wrapper_args[1]}"
    wrapper_args=("${wrapper_args[@]:2}")
    ;;
  --auth=*)
    auth_option="${wrapper_args[0]#--auth=}"
    [[ -n "${auth_option}" ]] || die "--auth requires a profile id"
    wrapper_args=("${wrapper_args[@]:1}")
    ;;
esac
set -- "${wrapper_args[@]}"

auth_command="${1:-}"
auth_command_profile=""
auth_command_profile_consumed=0
case "${auth_command}" in
  login|logout)
    if [[ -n "${2:-}" && "${2}" != -* ]]; then
      auth_command_profile="${2}"
      auth_command_profile_consumed=1
    fi
    ;;
esac

if [[ -n "${auth_option}" && -n "${auth_command_profile}" \
    && "${auth_option}" != "${auth_command_profile}" ]]; then
  die "conflicting auth profiles: --auth=${auth_option} and ${auth_command} ${auth_command_profile}"
fi

login_should_persist=0
if [[ -n "${auth_command_profile}" ]]; then
  MYCODEX_AUTH="${auth_command_profile}"
  AUTH_SELECTION_SOURCE="command line"
  [[ "${auth_command}" == "login" ]] && login_should_persist=1
elif [[ -n "${auth_option}" ]]; then
  MYCODEX_AUTH="${auth_option}"
  AUTH_SELECTION_SOURCE="--auth override"
elif [[ -n "${MYCODEX_AUTH-}" ]]; then
  AUTH_SELECTION_SOURCE="MYCODEX_AUTH override"
elif [[ -e "${AUTH_PROFILE_FILE}" || -L "${AUTH_PROFILE_FILE}" ]]; then
  MYCODEX_AUTH="$(read_persisted_auth_profile)"
  AUTH_SELECTION_SOURCE="persisted"
else
  MYCODEX_AUTH="openai"
  AUTH_SELECTION_SOURCE="default"
fi

case "${auth_command}" in
  login)
    if [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
      print_wrapper_auth_help
      exit 0
    fi
    if [[ -z "${auth_command_profile}" && "${AUTH_SELECTION_SOURCE}" == "default" ]]; then
      MYCODEX_AUTH="$(select_auth_profile_interactively)"
      AUTH_SELECTION_SOURCE="interactive selection"
      login_should_persist=1
    fi
    ;;
  auth)
    if [[ "${2:-status}" == "help" || "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
      print_wrapper_auth_help
      exit 0
    fi
    ;;
esac

# Exported so Compose can stamp the selected profile as a container label.
validate_profile_id "${MYCODEX_AUTH}"
export MYCODEX_AUTH
resolve_auth_profile

# Default to a per-project Codex state volume: it isolates each project's codex
# home/state and sidesteps the ownership drift a shared, long-lived home volume
# accumulates across projects and image versions. Opt back into a single shared
# volume with MYCODEX_SHARED_STATE=1.
private_env=()
if [[ "${MYCODEX_SHARED_STATE:-0}" != "1" ]]; then
  private_env=(--private-env)
fi

# Inject the profile's compose overlay ahead of the subcommand so the vendored
# launcher folds it in via its own -f handling.
profile_files=()
if [[ -n "${PROFILE_OVERLAY}" ]]; then
  profile_files=(-f "${PROFILE_OVERLAY}")
fi

# Route every Compose invocation the launcher makes through the profile's egress
# policy, and point the sidecar at the profile's provider config / model.
export MYCODEX_COMPOSE="vaka --vaka-file=${PROFILE_VAKA_FILE} compose"
if [[ -n "${PROFILE_LITELLM_CONFIG}" ]]; then
  export MYCODEX_LITELLM_CONFIG="${PROFILE_LITELLM_CONFIG}"
fi
if [[ -n "${MYCODEX_MODEL:-}" || -n "${PROFILE_DEFAULT_MODEL}" ]]; then
  export MYCODEX_MODEL="${MYCODEX_MODEL:-${PROFILE_DEFAULT_MODEL}}"
fi

# Authentication commands are recipe-level operations, not Compose verbs.
case "${auth_command}" in
  login)
    auth_args=("${wrapper_args[@]:1}")
    (( auth_command_profile_consumed )) && auth_args=("${wrapper_args[@]:2}")
    [[ ${#auth_args[@]} -eq 0 ]] \
      || die "login accepts at most one profile id"
    run_login
    if (( login_should_persist )); then
      persist_auth_profile "${MYCODEX_AUTH}"
      echo "myCodex: profile '${MYCODEX_AUTH}' is now the selected default." >&2
    fi
    exit 0
    ;;
  logout)
    auth_args=("${wrapper_args[@]:1}")
    (( auth_command_profile_consumed )) && auth_args=("${wrapper_args[@]:2}")
    [[ ${#auth_args[@]} -eq 0 ]] \
      || die "logout accepts at most one profile id"
    run_logout
    exit 0
    ;;
  auth)
    case "${2:-status}" in
      status)
        [[ $# -le 2 ]] || die "auth status accepts no arguments"
        run_auth_status
        ;;
      list)
        [[ $# -le 2 ]] || die "auth list accepts no arguments"
        run_auth_list
        ;;
      *)
        die "unknown auth command '${2}'; expected status or list"
        ;;
    esac
    exit 0
    ;;
  help|-h|--help)
    launcher help
    print_wrapper_auth_help
    exit 0
    ;;
esac

# Refuse to "activate" a profile that differs from the one already running when
# the verb cannot recreate containers to apply it. `up` is exempt: it recreates,
# and is the documented way to switch.
case "${1:-}" in
  ""|start|restart)
    guard_profile_switch
    ;;
esac

# Secrets are only needed for paths that (re)create the stack. ps/exec/logs/attach
# render Compose config without them (Compose prints a benign unset-var warning).
case "${1:-}" in
  ""|up|start|restart)
    acquire_credentials
    ;;
esac

exec "${BASH}" "${SCRIPT_DIR}/bin/myCodex" "${private_env[@]}" "${profile_files[@]}" "$@"
